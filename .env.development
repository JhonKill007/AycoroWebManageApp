REACT_APP_API_URL = 'https://api.aycoro.com'
REACT_APP_CHAT_URL = 'https://api.aycoro.com/aycoroHubs'
# REACT_APP_CHAT_URL = 'https://aycoroo.online/aycoroHubs'

# REACT_APP_API_URL = 'http://94.72.114.203:44321'
# REACT_APP_CHAT_URL = 'http://94.72.114.203:44383/aycoroHubs'

#  REACT_APP_API_URL = 'https://localhost:44383'
#  REACT_APP_CHAT_URL = 'https://localhost:44383/aycoroHubs'

REACT_APP_TITTLE_BASE = 'Aycoro'
GENERATE_SOURCEMAP=false

# Anti-automation seal for requests to AycoroWebApi. It can be extracted from the browser.
# Leave empty until the secret is injected at build time. Manage API requests are not sealed.
REACT_APP_AYCORO_SEAL_SECRET=
